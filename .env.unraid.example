# A filled-in example: the stack on an Unraid server behind Caddy, with the
# sites on qr4.dev. Copy it to .env (in the Compose Manager project folder,
# or next to docker-compose.yml) and fill in the three secrets; see
# .env.example for what each value means.

# --- Host paths (Unraid shares) ---------------------------------------------------
VAULT_DIR=/mnt/user/obsidian
BLOBS_DIR=/mnt/user/obsidian_blobs
# Set both: Compose Manager runs this file from its project folder on the
# flash drive, where the default ./data would land. Data stays outside the
# clone, so re-cloning or deploy/push.sh (PUSH_CHOWN=99:100) never touches it.
DATA_DIR=/mnt/user/appdata/obsidian
# The clone of this repository (git clone ... /mnt/user/appdata/obsidian-stack)
STACK_DIR=/mnt/user/appdata/obsidian-stack

# Unraid's nobody:users, the owner of files on the shares
PUID=99
PGID=100
TZ=Europe/Berlin

# --- Reverse proxy (Caddy) -----------------------------------------------------
# Caddy's Docker network; Caddy proxies obsidian.qr4.dev to obsidian-saver:8765
# and obsidian-sync.qr4.dev to obsidian-couchdb:5984
PROXY_NETWORK=main
SAVER_PORT=8765

# --- Save service --------------------------------------------------------------
PUBLIC_URL=https://obsidian.qr4.dev
API_TOKEN=
OLLAMA_URL=https://ollama.qr4.dev
OLLAMA_MODEL=qwen3.8:27b
WHISPER_MODEL=large-v3
VAULT_NAME=obsidian

# --- LiveSync ------------------------------------------------------------------
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=
LIVESYNC_DB=obsidian
LIVESYNC_PUBLIC_URL=https://obsidian-sync.qr4.dev
LIVESYNC_PASSPHRASE=
LIVESYNC_ID_KEY=

BRIDGE_IGNORE=
BRIDGE_RESCAN_HOURS=1

# Copy to .env next to docker-compose.yml and replace every <placeholder>.
# .env is never committed, and as a dot file LiveSync doesn't sync it either.
# Make secrets with `openssl rand -hex 24`. Hex keeps them free of `$` and
# quotes, which Compose would try to interpret.

# --- Host paths ----------------------------------------------------------------
# The server's copy of your Obsidian vault (the LiveSync bridge keeps it in sync)
VAULT_DIR=/path/to/obsidian-vault
# Videos and full git clones. Must NOT be inside the vault.
BLOBS_DIR=/path/to/obsidian-blobs
# Container state: the service's database, CouchDB, the bridge (default ./data)
DATA_DIR=./data
# Only when Compose runs this file from a different folder: this folder's path
#STACK_DIR=/path/to/save-service

# Owner of the files written into the vault and blob store. Match the user
# that owns VAULT_DIR (`id -u`, `id -g`; Unraid shares: 99 and 100).
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Reverse proxy -------------------------------------------------------------
# Existing Docker network your reverse proxy (Caddy, Traefik, ...) is on
PROXY_NETWORK=proxy
# Host port for direct LAN access to the web UI
SAVER_PORT=8765

# --- Save service --------------------------------------------------------------
# How your devices reach the service through the proxy. Written into note
# links to videos and repos: choose it once and keep it.
PUBLIC_URL=https://saver.example.com
# Optional; the UI and API then require it
API_TOKEN=
# LLM for tagging and summaries. Everything in this block can also be
# changed later in the web UI's Settings tab.
# Ollama server; on the Docker host itself: http://host.docker.internal:11434
OLLAMA_URL=http://<ollama-host>:11434
OLLAMA_MODEL=qwen3.8:27b
# Instead of Ollama: "openai" (OpenAI or any OpenAI-compatible server such as
# LM Studio, llama.cpp, vLLM, OpenRouter) or "anthropic". Then set LLM_MODEL,
# LLM_API_KEY for a hosted API, and LLM_URL for a local server
# (e.g. http://host.docker.internal:1234/v1).
LLM_PROVIDER=ollama
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
# faster-whisper model; large-v3-turbo is faster, small/medium suit a CPU
WHISPER_MODEL=large-v3
# Vault name in Obsidian, for obsidian:// links in the web UI
VAULT_NAME=obsidian

# --- LiveSync ------------------------------------------------------------------
# CouchDB administrator, also used by the plugin and the bridge
COUCHDB_USER=obsidian
COUCHDB_PASSWORD=
LIVESYNC_DB=obsidian
# How your devices reach CouchDB through the proxy (HTTPS)
LIVESYNC_PUBLIC_URL=https://sync.example.com

# End-to-end encryption passphrase. Every device needs it. Keep a copy:
# without it the database can't be read.
LIVESYNC_PASSPHRASE=
# ID key for the vault, shared by the Setup URI and the bridge. Make it once with
#   echo "sls-id-v1:$(openssl rand -hex 32)"
# and never change it afterwards.
LIVESYNC_ID_KEY=

# Extra paths the bridge never uploads from the server, as comma-separated
# globs. Example: Dumps/single_page/**,Dumps/pdf/**
BRIDGE_IGNORE=
# Hours between bridge restarts. Each restart rescans the vault and picks up
# files its watcher missed.
BRIDGE_RESCAN_HOURS=1
